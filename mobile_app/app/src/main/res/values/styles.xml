<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#070B14</item>
        <item name="android:navigationBarColor">#070B14</item>
        <item name="android:colorAccent">#E11D48</item>
        <item name="android:windowBackground">#070B14</item>
        <item name="android:textColor">#F4F7FB</item>
        <item name="android:textColorHint">#8B97A8</item>
        <item name="android:editTextColor">#F4F7FB</item>
        <item name="android:buttonStyle">@style/Widget.SmartAmbulance.Button</item>
    </style>

    <style name="Widget.SmartAmbulance.Button" parent="android:style/Widget.Material.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
</resources>
